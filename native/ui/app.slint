import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EcranConnexion } from "connexion.slint";

// Ce que Rust transmet a l'interface. Les champs portent les memes noms que
// dans la base : une traduction supplementaire serait un endroit de plus ou se
// tromper.
export struct EspaceVu { id: string, nom: string, initiales: string, actif: bool, teinte: brush }
export struct SalonVu { id: string, nom: string, vocal: bool, actif: bool }
export struct MessageVu {
    auteur: string,
    heure: string,
    corps: string,
    groupe: bool,
    initiales: string,
    teinte: brush,
}
export struct MembreVu { nom: string, initiales: string, teinte: brush, en-ligne: bool }

// Panneau detache.
//
// Le geste qui change le plus la lecture de l'ensemble : les colonnes quittent
// les bords de la fenetre et flottent sur le fond teinte. Une interface collee
// aux quatre bords et separee par des traits d'un pixel est exactement ce qui
// date une application — c'est le meme choix que sur le web.
component Panneau inherits Rectangle {
    in property <brush> teinte: Theme.fond-lateral;

    background: root.teinte;
    border-radius: Theme.rayon-lg;
    border-width: 1px;
    border-color: Theme.arete;
    drop-shadow-blur: Theme.ombre-flou;
    drop-shadow-offset-y: Theme.ombre-y;
    drop-shadow-color: Theme.ombre;
}

// Bouton du rail des espaces : cercle qui se carre au survol.
component BoutonRail inherits Rectangle {
    in property <string> initiales;
    in property <bool> actif: false;
    in property <brush> teinte: Theme.accent;

    width: 48px;
    height: 48px;
    border-radius: root.actif || zone.has-hover ? Theme.rayon-md : 24px;
    // Teinte permanente, assombrie au repos : un rail de pastilles grises ne
    // permet pas de reconnaitre un espace du coin de l'oeil.
    background: root.actif || zone.has-hover ? root.teinte : root.teinte.darker(0.45);

    animate border-radius, background { duration: 180ms; easing: ease-out; }

    callback clic();

    Text {
        text: root.initiales;
        color: Theme.texte;
        font-size: 15px;
        font-weight: 600;
    }

    zone := TouchArea { clicked => { root.clic(); } }
}

// Ligne de salon dans la liste laterale.
component LigneSalon inherits Rectangle {
    in property <string> nom;
    in property <bool> vocal: false;
    in property <bool> actif: false;

    height: 34px;
    border-radius: Theme.rayon-xs;
    background: root.actif ? Theme.actif : (zone.has-hover ? Theme.survol : transparent);

    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: start;

        Text {
            text: root.vocal ? "♪" : "#";
            color: Theme.texte-faible;
            font-size: 15px;
            vertical-alignment: center;
        }

        Text {
            text: root.nom;
            color: root.actif ? Theme.texte : Theme.texte-second;
            font-size: 14px;
            font-weight: root.actif ? 600 : 500;
            vertical-alignment: center;
        }
    }

    callback clic();
    zone := TouchArea { clicked => { root.clic(); } }
}

// En-tete de categorie.
component TitreCategorie inherits Rectangle {
    in property <string> titre;
    height: 28px;

    HorizontalLayout {
        padding-left: 8px;
        alignment: start;
        Text {
            text: root.titre;
            color: Theme.texte-faible;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// Un message, groupe ou non.
component Message inherits Rectangle {
    in property <string> auteur;
    in property <string> heure;
    in property <string> corps;
    in property <bool> groupe: false;
    in property <string> initiales;
    in property <brush> teinte: Theme.accent;

    height: root.groupe ? 24px : 60px;
    background: zone.has-hover ? Theme.survol : transparent;
    border-radius: Theme.rayon-sm;

    animate background { duration: 100ms; }

    // Liseré d'accent le long du bord gauche, comme sur le web. Il apparait en
    // opacite et non en largeur : une largeur animee decalerait le texte a
    // chaque passage de souris.
    Rectangle {
        x: 0;
        width: 2px;
        background: Theme.accent;
        opacity: zone.has-hover ? 1 : 0;
        animate opacity { duration: 120ms; }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: root.groupe ? 0px : 8px;
        spacing: 16px;
        alignment: start;

        // Gouttiere de 40 px, comme sur le web : le texte reste aligne que le
        // message porte un avatar ou non.
        Rectangle {
            width: 40px;
            height: root.groupe ? 0px : 40px;
            border-radius: 20px;
            background: root.groupe ? transparent : root.teinte;

            Text {
                text: root.groupe ? "" : root.initiales;
                color: Theme.texte;
                font-size: 14px;
                font-weight: 600;
            }
        }

        VerticalLayout {
            spacing: 2px;
            alignment: start;

            if !root.groupe: HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: root.auteur;
                    color: Theme.texte;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: root.heure;
                    color: Theme.texte-faible;
                    font-size: 11px;
                    vertical-alignment: bottom;
                }
            }

            Text {
                text: root.corps;
                color: Theme.texte-second;
                font-size: 15px;
            }
        }
    }

    zone := TouchArea {}
}

export component Coquille inherits Window {
    title: "Orbit";
    // Le fond porte les halos : sans eux, les gouttieres entre panneaux sont
    // du gris mort, et le relief ne se lit pas.
    background: @radial-gradient(circle, #2a2550 0%, Theme.fond-creux 62%);
    default-font-family: "Inter";
    // Slint refuse une taille fixe et un minimum sur la meme dimension. On
    // garde le minimum, qui empeche d'ecraser la mise en page au point qu'elle
    // n'ait plus de sens, et la taille de depart est posee depuis Rust.
    min-width: 900px;
    min-height: 600px;

    callback connecter();
    callback deconnecter();

    // Etat de session, pilote depuis Rust.
    in property <bool> connecte: false;
    in property <bool> occupe: false;
    in property <string> erreur;
    in property <string> nom-affiche;
    in property <string> pseudo;
    in property <string> mes-initiales;
    in-out property <string> email;
    in-out property <string> mot-de-passe;

    in property <[EspaceVu]> espaces;
    in property <[SalonVu]> salons;
    in property <[MessageVu]> messages;
    in property <[MembreVu]> membres;
    in property <string> espace-actif;
    in property <string> salon-actif;
    in property <string> sujet-salon;
    in property <bool> temps-reel: false;

    callback choisir-espace(string);
    callback choisir-salon(string);
    callback envoyer(string);

    VerticalLayout {
        spacing: 0px;

        // Tant qu'aucune session n'est ouverte, l'ecran de connexion occupe
        // toute la place : montrer une coquille vide derriere donnerait
        // l'impression d'une application a moitie chargee.
        if !root.connecte: EcranConnexion {
            occupe: root.occupe;
            erreur: root.erreur;
            email <=> root.email;
            mot-de-passe <=> root.mot-de-passe;
            connecter => { root.connecter(); }
        }

        // Quatre colonnes, detachees des bords et les unes des autres.
        if root.connecte: HorizontalLayout {
            spacing: Theme.ecart;
            padding: Theme.ecart;

            // 1. Rail des espaces.
            Panneau {
                width: Theme.rail;
                teinte: Theme.fond-rail;

                VerticalLayout {
                    padding-top: 12px;
                    spacing: 8px;
                    alignment: start;

                    for espace in root.espaces: BoutonRail {
                        initiales: espace.initiales;
                        actif: espace.actif;
                        teinte: espace.teinte;
                        clic => { root.choisir-espace(espace.id); }
                    }
                }
            }

            // 2. Salons.
            Panneau {
                width: Theme.lateral;

                VerticalLayout {
                    spacing: 0px;

                    Rectangle {
                        height: Theme.entete;
                        HorizontalLayout {
                            padding-left: 16px;
                            alignment: start;
                            Text {
                                text: root.espace-actif;
                                color: Theme.texte;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.bordure; }

                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        alignment: start;

                        TitreCategorie { titre: "SALONS"; }

                        for salon in root.salons: LigneSalon {
                            nom: salon.nom;
                            vocal: salon.vocal;
                            actif: salon.actif;
                            clic => { root.choisir-salon(salon.id); }
                        }
                    }

                    // Pousse la barre utilisateur au pied de la colonne.
                    Rectangle {}

                    // Barre utilisateur, comme sur le web : on doit voir qui
                    // l'on est sans avoir a ouvrir quoi que ce soit.
                    Rectangle {
                        height: 52px;
                        background: Theme.fond-creux;
                        border-radius: 0px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            alignment: start;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 16px;
                                background: Theme.accent;

                                Text {
                                    text: root.mes-initiales;
                                    color: white;
                                    font-size: 12px;
                                    font-weight: 600;
                                }

                                // Pastille de presence, posee sur le bord.
                                Rectangle {
                                    x: parent.width - 11px;
                                    y: parent.height - 11px;
                                    width: 11px;
                                    height: 11px;
                                    border-radius: 6px;
                                    background: Theme.succes;
                                    border-width: 2px;
                                    border-color: Theme.fond-creux;
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;

                                Text {
                                    text: root.nom-affiche;
                                    color: Theme.texte;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                HorizontalLayout {
                                    spacing: 5px;
                                    alignment: start;

                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        y: 4px;
                                        border-radius: 3px;
                                        background: root.temps-reel ? Theme.succes : Theme.alerte;
                                        animate background { duration: 300ms; }
                                    }

                                    Text {
                                        text: root.pseudo;
                                        color: Theme.texte-faible;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 3. Conversation.
            Panneau {
                teinte: Theme.fond-app;
                horizontal-stretch: 1;

                VerticalLayout {
                    spacing: 0px;

                    Rectangle {
                        height: Theme.entete;
                        HorizontalLayout {
                            padding-left: 16px;
                            spacing: 10px;
                            alignment: start;
                            Text {
                                text: root.salon-actif;
                                color: Theme.texte;
                                font-size: 15px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.sujet-salon;
                                color: Theme.texte-faible;
                                font-size: 13px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.bordure; }

                    ScrollView {
                        vertical-stretch: 1;

                        VerticalLayout {
                            padding-top: 12px;
                            spacing: 2px;
                            alignment: start;

                            for message in root.messages: Message {
                                auteur: message.auteur;
                                heure: message.heure;
                                corps: message.corps;
                                groupe: message.groupe;
                                initiales: message.initiales;
                                teinte: message.teinte;
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;

                        Rectangle {
                            height: 44px;
                            background: Theme.fond-releve;
                            border-radius: Theme.rayon-lg;
                            border-width: 1px;
                            border-color: saisie.has-focus ? Theme.accent : Theme.bordure;

                            animate border-color { duration: 120ms; }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;

                                // L'invite reste sous le champ tant qu'il est
                                // vide : Slint n'a pas de `placeholder`, et un
                                // champ nu ne dit pas ou l'on ecrit.
                                Rectangle {
                                    if saisie.text == "": Text {
                                        text: "Ecrire dans " + root.salon-actif;
                                        color: Theme.texte-faible;
                                        font-size: 15px;
                                        vertical-alignment: center;
                                        horizontal-alignment: left;
                                        x: 0;
                                    }

                                    saisie := TextInput {
                                        color: Theme.texte;
                                        font-size: 15px;
                                        vertical-alignment: center;
                                        single-line: true;
                                        accepted => {
                                            if (self.text != "") {
                                                root.envoyer(self.text);
                                                self.text = "";
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { height: 16px; }
                }
            }

            // 4. Membres.
            Panneau {
                width: Theme.membres;

                VerticalLayout {
                    padding: 8px;
                    padding-top: 16px;
                    spacing: 4px;
                    alignment: start;

                    TitreCategorie { titre: "MEMBRES — " + root.membres.length; }

                    for membre in root.membres: Rectangle {
                        height: 42px;
                        border-radius: Theme.rayon-xs;
                        background: zone-membre.has-hover ? Theme.survol : transparent;
                        animate background { duration: 120ms; }

                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 10px;
                            alignment: start;

                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 16px;
                                background: membre.teinte;
                                opacity: membre.en-ligne ? 1 : 0.4;

                                Text {
                                    text: membre.initiales;
                                    color: white;
                                    font-size: 12px;
                                    font-weight: 600;
                                }
                            }

                            Text {
                                text: membre.nom;
                                color: membre.en-ligne ? Theme.texte-second : Theme.texte-faible;
                                font-size: 14px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }

                        zone-membre := TouchArea {}
                    }
                }
            }
        }
    }
}
