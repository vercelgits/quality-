// Palette et mesures, reprises du client web.
//
// Un seul endroit pour les couleurs, comme les variables CSS de l'autre
// version : les deux clients doivent se ressembler, et deux palettes tenues
// separement finiraient par diverger.

export global Theme {
    // Surfaces, du plus profond au plus proche.
    out property <brush> fond-rail: #0a0a0c;
    out property <brush> fond-lateral: #121215;
    out property <brush> fond-app: #1a1a1e;
    out property <brush> fond-creux: #0f0f12;
    out property <brush> fond-releve: #1e1e23;

    // Texte.
    out property <brush> texte: #f2f3f5;
    out property <brush> texte-second: #b5bac1;
    out property <brush> texte-faible: #80848e;

    out property <brush> accent: #5865f2;
    out property <brush> accent-clair: #949cf7;
    out property <brush> succes: #23a559;
    out property <brush> alerte: #f0b232;
    out property <brush> danger: #da373c;

    out property <brush> bordure: #2a2a30;
    out property <brush> survol: #ffffff0a;
    out property <brush> actif: #ffffff14;

    // Relief. Deux couches par niveau, comme sur le web : une courte et dense
    // qui pose l'objet, une longue et diffuse qui donne la hauteur. Slint
    // n'accepte qu'une ombre portee par element, alors la courte est rendue par
    // une bordure claire sur l'arete superieure.
    out property <color> ombre: #00000070;
    out property <length> ombre-flou: 24px;
    out property <length> ombre-y: 6px;
    out property <color> arete: #ffffff0d;

    // Ecart entre les panneaux detaches, et retrait du bord de la fenetre.
    out property <length> ecart: 8px;

    // Mesures. Les memes que la version web, pour que passer de l'une a
    // l'autre ne demande pas de reapprendre ou se trouvent les choses.
    out property <length> rail: 72px;
    out property <length> lateral: 240px;
    out property <length> entete: 48px;
    out property <length> membres: 240px;

    // Rayons : la meme echelle elargie que sur le web.
    out property <length> rayon-xs: 8px;
    out property <length> rayon-sm: 10px;
    out property <length> rayon-md: 14px;
    out property <length> rayon-lg: 18px;
    out property <length> rayon-xl: 24px;
}
