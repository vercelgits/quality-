{
  "name": "orbit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Orbit - plateforme de communication temps reel, moderne et legere",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "natif": "cargo run --release --manifest-path native/Cargo.toml",
    "natif:test": "cargo test --release --manifest-path native/Cargo.toml -- --nocapture"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-notification": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
